<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/agent_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/agent_header_height"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/agent_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:src="@drawable/ic_baseline_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/agent_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/agent_model_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/agent_not_configured"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/agent_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/agent_clear"
            android:padding="11dp"
            android:src="@drawable/ic_outline_delete"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/agent_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/agent_settings"
            android:padding="11dp"
            android:src="@drawable/ic_baseline_settings"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/agent_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/agent_list_padding_horizontal"
            android:paddingVertical="8dp"
            android:scrollbars="none" />

        <!--
          Shown only while the conversation is empty. Placing it inside the list
          frame lets it use the full area instead of pinning suggestion chips
          above the messages, where they had no room and no context.
        -->
        <ScrollView
            android:id="@+id/agent_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_empty_title"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/agent_empty_summary"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agent_suggest_create"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical|start"
                    android:text="@string/agent_quick_create"
                    android:textAlignment="viewStart"
                    app:icon="@drawable/ic_baseline_add"
                    app:iconGravity="start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agent_suggest_apps"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:text="@string/agent_quick_apps"
                    android:textAlignment="viewStart"
                    app:icon="@drawable/ic_baseline_apps"
                    app:iconGravity="start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agent_suggest_diagnose"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:text="@string/agent_quick_diagnose"
                    android:textAlignment="viewStart"
                    app:icon="@drawable/ic_baseline_help_center"
                    app:iconGravity="start" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/agent_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/agent_input_hint"
            app:boxCornerRadiusBottomEnd="@dimen/agent_bubble_radius"
            app:boxCornerRadiusBottomStart="@dimen/agent_bubble_radius"
            app:boxCornerRadiusTopEnd="@dimen/agent_bubble_radius"
            app:boxCornerRadiusTopStart="@dimen/agent_bubble_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/agent_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:imeOptions="flagNoEnterAction"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="@dimen/agent_composer_button"
                android:minLines="1"
                android:singleLine="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="@dimen/agent_composer_button"
            android:layout_height="@dimen/agent_composer_button"
            android:layout_marginStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agent_send"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/agent_send"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:cornerRadius="@dimen/agent_bubble_radius"
                app:icon="@drawable/ic_agent_send"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agent_stop"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/agent_stop"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="@dimen/agent_bubble_radius"
                app:icon="@drawable/ic_agent_stop"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

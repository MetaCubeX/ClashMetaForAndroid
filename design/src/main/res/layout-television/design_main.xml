<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.MainDesign" />
        <variable
            name="clashRunning"
            type="boolean" />
        <variable
            name="forwarded"
            type="String" />
        <variable
            name="uploadSpeed"
            type="String" />
        <variable
            name="downloadSpeed"
            type="String" />
        <variable
            name="uploaded"
            type="String" />
        <variable
            name="downloaded"
            type="String" />
        <variable
            name="activeConnections"
            type="String" />
        <variable
            name="memoryUsage"
            type="String" />
        <variable
            name="mode"
            type="String" />
        <variable
            name="profileName"
            type="String" />
        <variable
            name="currentGroup"
            type="String" />
        <variable
            name="currentNode"
            type="String" />
        <variable
            name="providerSummary"
            type="String" />
        <variable
            name="colorClashStarted"
            type="int" />
        <variable
            name="colorClashStopped"
            type="int" />
        <variable
            name="hasProviders"
            type="boolean" />

        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_dashboard_background"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/tv_topbar_background"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clash_verge_macos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:text="@string/application_name"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:fillViewport="true"
                android:focusable="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.github.kr328.clash.design.view.TvNavigationItem
                        android:id="@+id/tv_nav_home"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:nextFocusDown="@id/tv_status"
                        android:onClick="@{() -> self.request(Request.OpenHome)}"
                        app:icon="@drawable/ic_tv_home"
                        app:text="@string/tv_home" />

                    <com.github.kr328.clash.design.view.TvNavigationItem
                        android:id="@+id/tv_nav_proxy"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:enabled="@{clashRunning}"
                        android:nextFocusDown="@id/tv_proxies"
                        android:onClick="@{() -> self.request(Request.OpenProxy)}"
                        app:icon="@drawable/ic_baseline_apps"
                        app:text="@string/proxy" />

                    <com.github.kr328.clash.design.view.TvNavigationItem
                        android:id="@+id/tv_nav_profiles"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:nextFocusDown="@id/tv_profiles"
                        android:onClick="@{() -> self.request(Request.OpenProfiles)}"
                        app:icon="@drawable/ic_baseline_view_list"
                        app:text="@string/profiles" />

                    <com.github.kr328.clash.design.view.TvNavigationItem
                        android:id="@+id/tv_nav_logs"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:nextFocusDown="@id/tv_mode_card"
                        android:onClick="@{() -> self.request(Request.OpenLogs)}"
                        app:icon="@drawable/ic_baseline_assignment"
                        app:text="@string/logs" />

                    <com.github.kr328.clash.design.view.TvNavigationItem
                        android:id="@+id/tv_nav_settings"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:nextFocusDown="@id/tv_mode_card"
                        android:onClick="@{() -> self.request(Request.OpenSettings)}"
                        app:icon="@drawable/ic_baseline_settings"
                        app:text="@string/settings" />

                    <com.github.kr328.clash.design.view.TvNavigationItem
                        android:id="@+id/tv_nav_help"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:nextFocusDown="@id/tv_mode_card"
                        android:onClick="@{() -> self.request(Request.OpenHelp)}"
                        app:icon="@drawable/ic_baseline_help_center"
                        app:text="@string/help" />

                    <com.github.kr328.clash.design.view.TvNavigationItem
                        android:id="@+id/tv_nav_about"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:nextFocusDown="@id/tv_mode_card"
                        android:onClick="@{() -> self.request(Request.OpenAbout)}"
                        app:icon="@drawable/ic_baseline_info"
                        app:text="@string/about" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="13dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tv_dashboard_subtitle"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@{clashRunning ? @drawable/tv_status_pill_running : @drawable/tv_status_pill_stopped}"
                    android:text="@{clashRunning ? @string/running : @string/stopped}"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="0.9"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:nextFocusUp="@id/tv_nav_home"
                    android:nextFocusRight="@id/tv_proxies"
                    android:onClick="@{() -> self.request(Request.ToggleStatus)}"
                    android:stateListAnimator="@animator/tv_dashboard_focus"
                    app:cardBackgroundColor="@color/tv_dashboard_card_background"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/tv_dashboard_card_stroke"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/tv_icon_tile_background"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_baseline_swap_vert"
                                app:tint="@color/tv_accent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="11dp"
                                android:layout_weight="1"
                                android:text="@string/tv_network_control"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@{clashRunning ? @drawable/tv_status_pill_running : @drawable/tv_status_pill_stopped}"
                                android:text="@{clashRunning ? @string/running : @string/stopped}"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="9dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@{clashRunning ? @string/tv_connected : @string/tv_status_action_stopped}"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{clashRunning ? @string/tv_status_action_running : @string/tv_remote_hint}"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_proxies"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.1"
                    android:alpha="@{clashRunning ? 1.0f : 0.48f}"
                    android:clickable="true"
                    android:enabled="@{clashRunning}"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:nextFocusLeft="@id/tv_status"
                    android:nextFocusUp="@id/tv_nav_proxy"
                    android:onClick="@{() -> self.request(Request.OpenProxy)}"
                    android:stateListAnimator="@animator/tv_dashboard_focus"
                    app:cardBackgroundColor="@color/tv_dashboard_card_background"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/tv_dashboard_card_stroke"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/tv_icon_tile_background"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_baseline_apps"
                                app:tint="@color/tv_accent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="11dp"
                                android:layout_weight="1"
                                android:text="@string/tv_current_node"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="@color/tv_accent"
                                android:textSize="25sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="9dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxLines="2"
                            android:text="@{currentNode}"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{@string/tv_current_group(currentGroup)}"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_profiles"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:nextFocusUp="@id/tv_status"
                    android:nextFocusRight="@id/tv_mode_card"
                    android:onClick="@{() -> self.request(Request.OpenProfiles)}"
                    android:stateListAnimator="@animator/tv_dashboard_focus"
                    app:cardBackgroundColor="@color/tv_dashboard_card_background"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/tv_dashboard_card_stroke"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/tv_icon_tile_background"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_baseline_cloud_download"
                                app:tint="@color/tv_accent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="11dp"
                                android:layout_weight="1"
                                android:text="@string/tv_current_profile"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="@color/tv_accent"
                                android:textSize="25sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="9dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxLines="2"
                            android:text="@{profileName != null ? profileName : @string/not_selected}"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tv_active_profile"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_mode_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:nextFocusLeft="@id/tv_profiles"
                    android:nextFocusUp="@id/tv_proxies"
                    android:onClick="@{() -> self.request(Request.OpenProxy)}"
                    android:stateListAnimator="@animator/tv_dashboard_focus"
                    app:cardBackgroundColor="@color/tv_dashboard_card_background"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/tv_dashboard_card_stroke"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/tv_icon_tile_background"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_baseline_dns"
                                app:tint="@color/tv_accent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="11dp"
                                android:layout_weight="1"
                                android:text="@string/tv_proxy_mode"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/tv_mode_chip_background"
                            android:text="@{mode}"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/tv_card_background"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tv_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="17dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_traffic_statistics"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="5dp"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_upload_speed"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@{uploadSpeed}"
                                android:textColor="@color/tv_upload"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_download_speed"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@{downloadSpeed}"
                                android:textColor="@color/tv_accent"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_uploaded"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@{uploaded}"
                                android:textColor="@color/tv_upload"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_downloaded"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@{downloaded}"
                                android:textColor="@color/tv_accent"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_active_connections"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@{activeConnections}"
                                android:textColor="@color/tv_success"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_memory_usage"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@{memoryUsage}"
                                android:textColor="@color/tv_memory"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</layout>
